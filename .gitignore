node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
dist-ssr/
build/
*.local

# --- Test and coverage output ---
coverage/
.vitest/
*.lcov

# --- Caches ---
.eslintcache
.cache/
.vite/
.turbo/

# --- IntelliJ IDEA ---
.idea/
.idea_modules/
*.iml
*.ipr
*.iws
out/

# --- VS Code ---
.vscode/*
!.vscode/extensions.json

# --- OS ---
.DS_Store
Thumbs.db

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Local agent + tooling state ---
.serena/
.claude/settings.local.json

# --- Docs scratch ---
# ai-prompts is a personal dumping ground for AI prompts: keep the directory,
# ignore everything in it except the placeholder that keeps it tracked.
docs/ai-prompts/*
!docs/ai-prompts/.gitkeep

# --- Python (docs/tooling) ---
docs/tooling/.venv/
docs/tooling/**/__pycache__/
docs/tooling/**/*.egg-info/
docs/tooling/.mypy_cache/
docs/tooling/.ruff_cache/
docs/tooling/.pytest_cache/
docs/tooling/.coverage
docs/tooling/coverage.xml
docs/tooling/htmlcov/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

*storybook.log
storybook-static
